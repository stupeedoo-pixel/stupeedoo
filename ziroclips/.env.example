# =============================================================================
# ZiroClips configuration — shared by web/ (Next.js) and worker/ (Python).
# Copy to ziroclips/.env  (the worker reads it from there; for the web app,
# symlink or copy it to web/.env:  ln -s ../.env web/.env)
# =============================================================================

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ziroclips
# openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Personal mode: first account becomes ADMIN on the UNLIMITED plan.
SINGLE_USER_MODE=true
# Flip to false after creating your account to lock the instance down.
ALLOW_REGISTRATION=true

# Google OAuth (optional). Redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Storage ----------------------------------------------------------------
# local = files on disk (shared by web + worker). s3 = S3/R2/MinIO.
STORAGE_DRIVER=local
# Relative to web/ (the worker resolves it the same way). Use an absolute path in Docker.
STORAGE_LOCAL_DIR=../storage
# S3_BUCKET=ziroclips
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # true for MinIO

# --- AI providers -----------------------------------------------------------
# Transcription: openai | faster_whisper | mock (offline placeholder words)
TRANSCRIBE_PROVIDER=openai
OPENAI_API_KEY=
# Cheaper Whisper large-v3 via Groq (OpenAI-compatible):
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Local faster-whisper settings (TRANSCRIBE_PROVIDER=faster_whisper):
# WHISPER_MODEL=large-v3          # or distil-large-v3 / small on CPU
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=auto

# Highlight detection + virality reasoning: anthropic | heuristic
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=medium

# --- Limits & behaviour -----------------------------------------------------
MAX_UPLOAD_BYTES=10737418240
MAX_VIDEO_MINUTES=240
ENABLE_YOUTUBE=true
# REDIS_URL=redis://localhost:6379   # enables shared rate limits across web instances

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=1
PROXY_HEIGHT=540
EXPORT_PRESET=medium
EXPORT_TTL_DAYS=14
SOURCE_TTL_DAYS=0
LOG_LEVEL=INFO
LOG_JSON=false
